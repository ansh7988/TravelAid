# Copy to .env.local for local experiments. Never commit real values.
# Nothing here is required to run the prototype.

# Placeholder for a future nearby-places provider. Leave unset for the honest
# "not configured" state. Anything prefixed VITE_ is visible to every visitor,
# so a real provider key must live behind a server-side proxy instead.
# VITE_PLACES_PROVIDER=none

# Future Supabase (not used in this version)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-public-only
